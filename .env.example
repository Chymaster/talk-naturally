# Copy to .env and fill in. NEVER commit values (AGENT.md §12.7).
# This file documents variable NAMES only.

# --- Server host ---------------------------------------------------------
# SQLite file used for all server-side learner data (single v1 engine).
TALK_DB_PATH=./var/talk-naturally.db

# --- Built-in material ---------------------------------------------------
# Directory holding the built-in level catalog (manifest.json + one JSON file
# per level). Onboarding resolves a learner's language and level here.
TALK_BUILTIN_DIR=datasets/builtin

# --- Model provider (deployer-level configuration) ----------------------
# Any OpenAI-compatible endpoint. Defaults below are the built-in default
# (MVP.md §3): DeepSeek official API + deepseek-flash.
TALK_MODEL_BASE_URL=https://api.deepseek.com/v1
TALK_MODEL_ID=deepseek-flash
# Deployer key. A learner-supplied token takes precedence at runtime and is
# not persisted in the PoC (MVP.md §3.3).
TALK_MODEL_API_KEY=
# Optional capability override for other endpoints:
# JSON with structuredOutput/toolCalls/streaming/maxContextTokens.
TALK_MODEL_CAPABILITIES=

# --- Discord channel ----------------------------------------------------
# With DISCORD_APP_ID, enables the Discord channel.
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=

# --- Telegram channel ---------------------------------------------------
# Bot token from @BotFather; enables the Telegram channel (long polling, no
# webhook or public URL). At least one channel must be configured.
TELEGRAM_TOKEN=

# --- Scheduler (proactive session start) --------------------------------
# Hour of day, server local time. Empty disables the timer.
TALK_SCHEDULE_HOUR=9
