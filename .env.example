# Copy to .env and fill in. NEVER commit values (AGENT.md §12.7).
# This file documents variable NAMES only.

# --- Server host ---------------------------------------------------------
# SQLite file used for all server-side learner data (single v1 engine).
TALK_DB_PATH=./var/talk-naturally.db

# --- Model provider (deployer-level configuration) ----------------------
# Any OpenAI-compatible endpoint. Defaults below are the built-in default
# (MVP.md §3): OpenRouter + google/gemma-4-26b-a4b-it.
TALK_MODEL_BASE_URL=https://openrouter.ai/api/v1
TALK_MODEL_ID=google/gemma-4-26b-a4b-it
# Deployer key. A learner-supplied token takes precedence at runtime and is
# not persisted in the PoC (MVP.md §3.3).
TALK_MODEL_API_KEY=
# Optional capability override for non-OpenRouter endpoints:
# JSON with structuredOutput/toolCalls/streaming/maxContextTokens.
TALK_MODEL_CAPABILITIES=

# --- Discord channel ----------------------------------------------------
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=

# --- Scheduler (proactive session start) --------------------------------
# Hour of day, server local time. Empty disables the timer.
TALK_SCHEDULE_HOUR=9
